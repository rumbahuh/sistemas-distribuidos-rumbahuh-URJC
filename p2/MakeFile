CC = gcc
CFLAGS = -Wall -Wextra -Wshadow -g -O0 -pthread

TARGETS = P1 P2 P3
COMMON_OBJ = stub.o

all: $(TARGETS)

%.o: %.c stub.h
	$(CC) $(CFLAGS) -c -o $@ $<

P1: P1.o $(COMMON_OBJ)
	$(CC) $(CFLAGS) -o $@ $^

P2: P2.o $(COMMON_OBJ)
	$(CC) $(CFLAGS) -o $@ $^

P3: P3.o $(COMMON_OBJ)
	$(CC) $(CFLAGS) -o $@ $^

clean:
	rm -f $(TARGETS) *.o *.gch

.PHONY: all clean